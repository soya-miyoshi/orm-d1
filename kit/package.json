{
	"name": "d1zzle-migrate",
	"version": "0.1.4",
	"description": "Migrations, introspection and drift detection for d1zzle on Cloudflare D1.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soya-miyoshi/d1zzle.git",
		"directory": "kit"
	},
	"homepage": "https://github.com/soya-miyoshi/d1zzle#readme",
	"bugs": {
		"url": "https://github.com/soya-miyoshi/d1zzle/issues"
	},
	"engines": {
		"node": ">=22.15"
	},
	"bin": {
		"d1zzle-migrate": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"d1zzle": "^0.1.4"
	},
	"dependencies": {},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260707.2"
	},
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public"
	}
}
