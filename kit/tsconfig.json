{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		// The kit runs in Node, not in workerd: it may use Node builtins and
		// contributes zero bytes to the Worker bundle. The Workers types come
		// along because it imports orm-d1, which is typed against them.
		"types": ["node"],
		// Against the built declarations, exactly as a published install
		// resolves them — which also keeps workerd globals out of this program.
		"paths": {
			"orm-d1": ["../dist/index.d.ts"],
			"orm-d1/ddl": ["../dist/ddl.d.ts"],
			"orm-d1/relations": ["../dist/relations/index.d.ts"]
		}
	},
	"include": ["src"]
}
